@page "/login"
@using System.Net
@using System.Text.Json
@inject IHttpClientFactory Factory
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject NavigationManager Navigation

<h3>Connexion</h3>

<input @bind="login" class="form-control" placeholder="Login (ex : user1)" />

<input @bind="motDePasse" type="password" class="form-control mt-2" placeholder="Mot de passe" />

<button class="btn btn-primary mt-2" @onclick="SeConnecter">Se connecter</button>

@if (!string.IsNullOrEmpty(message))
{
    <p class="text-danger mt-2">@message</p>
}

@code
{
    // Login saisi par l'utilisateur
    private string login = "";
    // Mot de passe saisi par l'utilisateur
    private string motDePasse = "";
    // Message d'erreur affiché sous le bouton
    private string message = "";

