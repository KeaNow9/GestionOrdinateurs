    // Demande un token à Keycloak en passant par AuthentificationApi
    private async Task SeConnecter()
    {
        var client = Factory.CreateClient("AuthApi");
        var reponse = await client.PostAsJsonAsync("api/Authentication/login", new { Username = login, Password = motDePasse });

        // Login ou mot de passe incorrect
        if (reponse.StatusCode == HttpStatusCode.Unauthorized)
        {
            message = "Login ou mot de passe incorrect";
            return;
        }

        // Lecture du token dans la réponse de Keycloak
        var resultat = await reponse.Content.ReadFromJsonAsync<JsonElement>();
        var token = resultat.GetProperty("access_token").GetString();

        // Token reçu : on le garde en session
        await SessionStorage.SetItemAsync("jwtToken", token);

        // Retour à l'accueil
        Navigation.NavigateTo("/");
    }
}
