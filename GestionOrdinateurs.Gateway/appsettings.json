{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",
  "ReverseProxy": {
  "Routes": {
    "routeOrdinateurs": {
      "ClusterId": "apiGestionOrdinateurs",
      "Match": { "Path": "/api/Ordinateurs/{**catch-all}" }
    },
    "routeReparations": {
      "ClusterId": "apiGestionOrdinateurs",
      "Match": { "Path": "/api/Reparations/{**catch-all}" }
    }
  },
  "Clusters": {
    "apiGestionOrdinateurs": {
      "Destinations": {
        "api": { "Address": "http://localhost:5046/" }
      }
    }
  }
}

}
